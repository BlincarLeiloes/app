# Copie este arquivo para .env e preencha o que precisar.
# Nada aqui é obrigatório para rodar no seu PC.

# Porta do servidor (a hospedagem costuma definir sozinha)
PORT=3000

# Banco de dados:
# - deixe vazio para usar SQLite (arquivo data/app.db)
# - ou cole a URL do PostgreSQL (ex.: Neon) para hospedar de graça
DATABASE_URL=

# Só a primeira conta pode ser criada. Coloque true para liberar mais cadastros.
ALLOW_SIGNUP=false

# Fuso horário usado para saber "que dia é hoje"
APP_TIMEZONE=America/Sao_Paulo

# Open Finance (opcional) — veja docs/OPEN_FINANCE.md
# NUNCA coloque esses valores no GitHub. Só no .env ou no painel da hospedagem.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
